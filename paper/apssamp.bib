@article{JAFFE1981467,
title = {Twist-4 in the QCD analysis of leptoproduction},
journal = {Physics Letters B},
volume = {105},
number = {6},
pages = {467-472},
year = {1981},
issn = {0370-2693},
doi = {10.1016/0370-2693(81)91206-5},
url = {https://www.sciencedirect.com/science/article/pii/0370269381912065},
author = {R.L. Jaffe and M. Soldate},
abstract = {A systematic method of calculating twist-4 corrections, based on the operator product expansion in QCD, is described and applied to the lowest moment of the transverse structure function in electroproduction. The scheme combines perturbative QCD (for the coefficient functions and anomalous dimensions) with the bag model (for the matrix elements). A special operator basis is introduced in which a parton interpretation of twist-4 effects emerges naturally. In a “parton approximation”, the twist-4 corrections to the lowest moment are negligible.}
}

