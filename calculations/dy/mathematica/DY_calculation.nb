      RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
      RowBox[{"p", "[", "2", "]"}]}]}]}]], "-", 
  FractionBox[
   RowBox[{"prop", "[", "4", "]"}], 
   RowBox[{
    SuperscriptBox["m", "2"], "-", 
