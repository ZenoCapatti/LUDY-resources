Cell[BoxData[{
 RowBox[{
  RowBox[{"elidedprops", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"propsi", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"numeratorReducedtopo", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"prop", "[", "i_", "]"}], ",", "Infinity"}], "]"}], "]"}]}],
       ";", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "*", 
           RowBox[{"Times", "@@", "propsi"}]}], "//", "Simplify"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"List", "@@", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"numeratorReducedtopo", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "+", "g"}], ")"}]}], "]"}],
               ">", "2"}], ",", 
             RowBox[{"List", "@@", 
              RowBox[{"numeratorReducedtopo", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"numeratorReducedtopo", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}]}], "}"}]}], 
        "]"}], "//", "Total"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "numeratorReducedtopo", "]"}]}], "}"}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"mappedtopos", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"propsi", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"numeratorReducedtopo", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"prop", "[", "i_", "]"}], ",", "Infinity"}], "]"}], "]"}]}], 
     ";", 
     RowBox[{"coeffpropsi", "=", 
      RowBox[{"CoefficientRules", "[", 
       RowBox[{
        RowBox[{"elidedprops", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "propsi"}], "]"}]}], ";", 
     RowBox[{"{", " ", 
      RowBox[{"propsi", ",", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Int", "[", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"First", "[", "a", "]"}]}], "+", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"First", "[", "a", "]"}], "/.", "coeffpropsi"}], ")"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "coeffpropsi"}], "}"}]}], "]"}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "numeratorReducedtopo", "]"}]}], "}"}]}], 
   "]"}]}]}], "Input",
