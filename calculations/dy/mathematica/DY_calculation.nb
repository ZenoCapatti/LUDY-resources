             RowBox[{"{", 
              RowBox[{"numeratorReducedxbox", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}]}], "}"}]}], 
        "]"}], "//", "Total"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
