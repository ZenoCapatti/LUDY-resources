Cell[CellGroupData[{

Cell["Cut filtering ", "Subsection",
 CellChangeTimes->{{3.970747658038547*^9, 3.9707476759278812`*^9}, 
   3.97079942103296*^9},ExpressionUUID->"8743fd2a-44f7-4379-87ac-\
264afc65a54b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cutFilter", "[", 
   RowBox[{"topo_", ",", "cuts_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "cutinds", ",", "terms", ",", "topoinds", ",", "indsterm", ",", 
      "cutrestr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cutinds", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Position", "[", 
        RowBox[{"cuts", ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "!=", "0"}], "&"}], ")"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"List", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"topo", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "+", "g"}], "//", "Expand"}], 
            ")"}]}], "]"}], ">", "2"}], ",", 
        RowBox[{"List", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"topo", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "//", "Expand"}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"topo", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{"cutinds", ",", 
          RowBox[{
           RowBox[{"topo", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"prop", "[", "x_", "]"}], ":>", "x"}], "}"}]}]}], "]"}], 
        "==", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"topo", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"topoinds", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"Cases", "[", 
                 RowBox[{
                  RowBox[{"g", " ", "+", "elem"}], ",", 
                  RowBox[{"Int", "[", 
                   RowBox[{"x_", ",", "y_"}], "]"}], ",", "Infinity"}], "]"}],
                 "[", 
                RowBox[{"[", "1", "]"}], "]"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Int", "[", 
                  RowBox[{"x_", ",", "y_"}], "]"}], ":>", "y"}], "}"}]}]}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"cutrestr", "=", 
              RowBox[{"cuts", "[", 
               RowBox[{"[", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"topo", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "/.", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"prop", "[", "x_", "]"}], ":>", "x"}], "}"}]}], 
                 ")"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"indsterm", "=", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"cutrestr", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "*", 
                    RowBox[{"topoinds", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ">", "0"}], ",", "1", 
                  ",", "0"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", 
                  RowBox[{"Length", "[", "cutrestr", "]"}]}], "}"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"indsterm", "==", 
                RowBox[{"(", 
                 RowBox[{"cuts", "//", "Total"}], ")"}]}], ",", "elem", ",", 
               "0"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"elem", ",", "terms"}], "}"}]}], "]"}], "//", 
          "Total"}]}], "}"}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"topo", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "0"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.970798254979702*^9, 3.97079828746224*^9}, {
   3.9707983206320457`*^9, 3.970798824758919*^9}, {3.970798855211061*^9, 
