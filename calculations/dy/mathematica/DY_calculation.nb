    RowBox[{
     RowBox[{"q", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"q", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "1", "]"}]}], "+", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
