Cell[BoxData[
 RowBox[{
  RowBox[{"distributionCanonicaliser", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "terms", ",", "plusterms", ",", "elem", ",", "remaining", ",", 
      "canonicalisedTerms", ",", "power", ",", " ", "polys"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"terms", "=", 
      RowBox[{"List", "@@", 
       RowBox[{"(", 
        RowBox[{"expr", "//", "Expand"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plusterms", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"terms", ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Or", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"List", "@@", "#"}], ")"}], ",", 
              RowBox[{"plus", "[", "\"\<1/(1-2z)\>\"", "]"}]}], "]"}], ",", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"List", "@@", "#"}], ")"}], ",", 
              RowBox[{"plus", "[", "\"\<log(1-2z)/(1-2z)\>\"", "]"}]}], "]"}],
             ",", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"List", "@@", "#"}], ")"}], ",", 
              RowBox[{"plus", "[", "\"\<1/(1-z)\>\"", "]"}]}], "]"}], ",", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"List", "@@", "#"}], ")"}], ",", 
              RowBox[{"plus", "[", "\"\<log(1-z)/(1-z)\>\"", "]"}]}], "]"}]}],
            "]"}], "&"}], ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"remaining", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"terms", ",", "plusterms"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"canonicalisedTerms", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"polys", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"List", "@@", 
                RowBox[{"(", "elem", ")"}]}], ")"}], ",", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Or", "[", 
                 RowBox[{
                  RowBox[{"#", "==", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"#", "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"z", "^", "n_"}], ":>", "z"}], "}"}]}], ")"}], 
                    "^", 
                    RowBox[{"(", 
                    RowBox[{"#", "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"z", "^", "n_"}], ":>", "n"}], "}"}]}], ")"}]}]}],
                   ",", 
                  RowBox[{"#", "==", "z"}]}], "]"}], "&"}], ")"}]}], "]"}], 
            ",", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"ToString", "[", 
                RowBox[{"D", "[", 
                 RowBox[{"#", ",", "z"}], "]"}], "]"}], "!=", "\"\<0\>\""}], 
              "&"}], ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "polys", "]"}], "==", "0"}], ",", 
           RowBox[{"power", "=", "0"}], ",", 
           RowBox[{"power", "=", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"polys", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"z", "^", "n_"}], ":>", 
                 RowBox[{"n", "-", "1"}]}], "}"}]}], "/.", 
              RowBox[{"{", 
               RowBox[{"z", "->", "0"}], "}"}]}], ")"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"elem", "/", 
             RowBox[{"z", "^", "power"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"plus", "[", "\"\<1/(1-z)\>\"", "]"}], "->", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{"z", "^", "i"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "0", ",", 
                    RowBox[{"power", "-", "1"}]}], "}"}]}], "]"}]}], "+", 
               RowBox[{"plus", "[", "\"\<1/(1-z)\>\"", "]"}]}]}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"plus", "[", "\"\<1/(1-2z)\>\"", "]"}], "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "1"}], "/", 
                   RowBox[{
                    RowBox[{"(", "2", ")"}], "^", "power"}]}], " ", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "z"}], ")"}], "^", "i"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"power", "-", "1"}]}], "}"}]}], "]"}]}], "+", 
                 RowBox[{
                  RowBox[{"1", "/", 
                   RowBox[{"(", 
                    RowBox[{"2", "^", "power"}], ")"}]}], 
                  RowBox[{"plus", "[", "\"\<1/(1-2z)\>\"", "]"}]}]}]}], ",", 
               RowBox[{
                RowBox[{"plus", "[", "\"\<log(1-2z)/(1-2z)\>\"", "]"}], "->", 
                
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "1"}], "/", 
                   RowBox[{
                    RowBox[{"(", "2", ")"}], "^", "power"}]}], " ", 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "z"}], ")"}], "^", "i"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"power", "-", "1"}]}], "}"}]}], "]"}], 
                  RowBox[{"Log", "[", 
                   RowBox[{"1", "-", 
                    RowBox[{"2", "z"}]}], "]"}]}], "+", 
                 RowBox[{
                  RowBox[{"1", "/", 
                   RowBox[{"(", 
                    RowBox[{"2", "^", "power"}], ")"}]}], 
                  RowBox[{
                  "plus", "[", "\"\<log(1-2z)/(1-2z)\>\"", "]"}]}]}]}], ","}],
               "*)"}], 
             RowBox[{
              RowBox[{"plus", "[", "\"\<log(1-z)/(1-z)\>\"", "]"}], "->", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"Sum", "[", 
                  RowBox[{
                   RowBox[{"z", "^", "i"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "0", ",", 
                    RowBox[{"power", "-", "1"}]}], "}"}]}], "]"}]}], 
                RowBox[{"Log", "[", 
                 RowBox[{"1", "-", "z"}], "]"}]}], "+", 
               RowBox[{"plus", "[", "\"\<log(1-z)/(1-z)\>\"", "]"}]}]}]}], 
            "}"}]}], " ", ")"}]}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"elem", ",", "plusterms"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Plus", "@@", "canonicalisedTerms"}], ")"}], "+", 
           RowBox[{"(", 
            RowBox[{"Plus", "@@", "remaining"}], ")"}]}], ")"}], "//", 
         "Expand"}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", "z", "]"}], 
          RowBox[{"plus", "[", "\"\<1/(1-z)\>\"", "]"}]}], "->", 
         RowBox[{
          RowBox[{"Log", "[", "z", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "z"}], ")"}]}]}], "}"}]}], "//", 
      "Simplify"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9712352058135366`*^9, 3.971235206402967*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"50b8d7ff-6efc-4e06-af19-e9857acb92b2"]
