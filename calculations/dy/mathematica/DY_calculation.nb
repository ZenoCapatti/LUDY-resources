    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
      RowBox[{"q", "[", "1", "]"}]}]}], "+", 
    RowBox[{
     RowBox[{"p", "[", "2", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "2", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "2", "]"}], "\[CenterDot]", 
      RowBox[{"q", "[", "1", "]"}]}]}], "+", 
