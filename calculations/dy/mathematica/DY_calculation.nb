Cell["\<\
This function identifies scalar products that are dependent on the \
integration momentum q[1]\
\>", "Text",
 CellChangeTimes->{{3.970741288309636*^9, 
  3.970741306616168*^9}},ExpressionUUID->"7254d890-0bfc-49ef-889d-\
c69025c41035"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"loopProducts", "[", "props_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"allsps", ",", "extsps", ",", "loopsps"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"allsps", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"List", "@@", "prps"}], ",", 
            RowBox[{"{", 
             RowBox[{"prps", ",", "props"}], "}"}]}], "]"}], "//", 
          "Flatten"}], "//", "DeleteDuplicates"}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"extsps", "=", 
       RowBox[{"allsps", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"IP", "[", 
            RowBox[{"x_", ",", 
             RowBox[{"q", "[", "1", "]"}]}], "]"}], ":>", "0"}], ",", 
          RowBox[{
           RowBox[{"IP", "[", 
            RowBox[{"x_", ",", 
             RowBox[{"k", "[", "1", "]"}]}], "]"}], ":>", "0"}]}], "}"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"loopsps", "=", 
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{"allsps", ",", "extsps"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"y_", "*", 
           RowBox[{"IP", "[", 
            RowBox[{"x_", ",", "z_"}], "]"}]}], ":>", 
          RowBox[{"IP", "[", 
           RowBox[{"x", ",", "z"}], "]"}]}], "}"}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"loopProducts", "[", "prp", "]"}]}], "Input",
 CellChangeTimes->{{3.970741242336606*^9, 3.970741242760116*^9}, {
  3.9708047294466333`*^9, 3.9708047317734737`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"fd9a0e85-bd4b-4bf1-bf9d-193dea0431b0"],

