 RowBox[{"prp", "[", 
  RowBox[{"[", 
   RowBox[{
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"mappedtopos", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      RowBox[{"prop", "[", "i_", "]"}], ",", "Infinity"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"prop", "[", "x_", "]"}], ":>", "x"}], "}"}]}], "]"}], 
  "]"}]], "Input",
