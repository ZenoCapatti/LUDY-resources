Cell["Define a symmetric and linear scalar product", "Text",
 CellChangeTimes->{{3.970741270620332*^9, 
  3.970741280165258*^9}},ExpressionUUID->"8860fe59-9a96-4305-91f8-\
4b64399e3a8d"],

Cell[BoxData[
 RowBox[{"SetAttributes", "[", 
  RowBox[{"IP", ",", "Orderless"}], "]"}]], "Input",
 CellChangeTimes->{{3.970741096822279*^9, 3.970741127117662*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"707b1ccd-5743-4d3f-9f08-4403385e4831"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"IP", "[", 
   RowBox[{
    RowBox[{"x_", "+", "y_"}], ",", "z_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"IP", "[", 
    RowBox[{"x", ",", "z"}], "]"}], "+", 
   RowBox[{"IP", "[", 
    RowBox[{"y", ",", "z"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IP", "[", 
   RowBox[{
    RowBox[{"-", "x_"}], ",", "z_"}], "]"}], ":=", 
  RowBox[{"-", 
   RowBox[{"IP", "[", 
    RowBox[{"x", ",", "z"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.970741190832468*^9, 3.970741233628196*^9}, {
  3.970742622358429*^9, 3.970742632488065*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"07dfb697-6f9d-4129-b056-22cb4aeaa473"],

Cell["Define propagators", "Text",
 CellChangeTimes->{{3.970741282046431*^9, 
  3.9707412864049387`*^9}},ExpressionUUID->"2d9643dc-87f7-4c1f-a11b-\
73e76412b836"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"prp", "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sq", "[", 
       RowBox[{"q", "[", "1", "]"}], "]"}], "-", 
      RowBox[{"m", "^", "2"}]}], ",", 
     RowBox[{"Sq", "[", 
      RowBox[{
       RowBox[{"q", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "1", "]"}]}], "]"}], ",", 
     RowBox[{"Sq", "[", 
      RowBox[{
       RowBox[{"q", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "2", "]"}]}], "]"}], ",", 
     RowBox[{"Sq", "[", 
      RowBox[{
       RowBox[{"q", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "2", "]"}]}], "]"}]}], "}"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sq", "[", "x_", "]"}], ":>", 
     RowBox[{"IP", "[", 
      RowBox[{"x", ",", "x"}], "]"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9707410868094177`*^9, 3.970741087309093*^9}, {
  3.970741130325859*^9, 3.970741138148344*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"4e1995a2-7ab3-4773-a4cf-20317ed50d6d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["m", "2"]}], "+", 
    RowBox[{
     RowBox[{"q", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"q", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "1", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
      RowBox[{"q", "[", "1", "]"}]}]}], "+", 
    RowBox[{
     RowBox[{"q", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"q", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "2", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "2", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "2", "]"}], "\[CenterDot]", 
      RowBox[{"q", "[", "1", "]"}]}]}], "+", 
    RowBox[{
     RowBox[{"q", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"q", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "1", "]"}]}], "+", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
      RowBox[{"p", "[", "2", "]"}]}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
      RowBox[{"q", "[", "1", "]"}]}]}], "+", 
    RowBox[{
     RowBox[{"p", "[", "2", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "2", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "2", "]"}], "\[CenterDot]", 
      RowBox[{"q", "[", "1", "]"}]}]}], "+", 
