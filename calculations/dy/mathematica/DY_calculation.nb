Cell["\<\
It would be convenient to start dropping a bunch of topologies now, since \
they are not compatible with the cut. However we will instead reduce \
separately the four classes, just to show that it is possible to do so.\
\>", "Text",
 CellChangeTimes->{{3.970746535804441*^9, 3.970746562250642*^9}, {
  3.9707466010465803`*^9, 
  3.970746641884207*^9}},ExpressionUUID->"db021d18-d2ce-4cba-874c-\
749142635c0a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rep$onshell", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sq", "[", 
       RowBox[{"p", "[", "1", "]"}], "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{"Sq", "[", 
       RowBox[{"p", "[", "2", "]"}], "]"}], "->", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"p", "[", "1", "]"}], ".", 
       RowBox[{"p", "[", "2", "]"}]}], "->", 
      RowBox[{"s", "/", "2"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9707466433202667`*^9, 3.970746676115079*^9}, {
  3.970805077344466*^9, 3.970805078815531*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"84ba8c9b-57c3-4b65-9171-03be82f56bcd"],

