Cell["\<\
This function derives the decomposition of scalar products in terms of \
propagators\
\>", "Text",
 CellChangeTimes->{{3.970741308423582*^9, 
  3.970741326879125*^9}},ExpressionUUID->"4a67a440-82c2-4ec8-a576-\
534e52366d48"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numeratorRelations", "[", 
   RowBox[{"props_", ",", "indices_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"loopsps", ",", "mons", ",", "subrules", ",", "rests"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"loopsps", "=", 
      RowBox[{"loopProducts", "[", "props", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mons", "=", 
      RowBox[{"MonomialList", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", "prop", "]"}], "prop"}], ",", 
          RowBox[{"{", 
           RowBox[{"prop", ",", "props"}], "}"}]}], "]"}], ",", "loopsps"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"subrules", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"mons", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "==", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"j", "==", "i"}], ",", 
               RowBox[{"loopsps", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", "0"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "loopsps", "]"}]}], "}"}]}], "]"}], ",", 
          
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"a", "[", "prop", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"prop", ",", "props"}], "}"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "loopsps", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rests", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", "prop", "]"}], "prop"}], ",", 
              RowBox[{"{", 
               RowBox[{"prop", ",", "props"}], "}"}]}], "]"}], "/.", 
            RowBox[{"subrules", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "-", 
          RowBox[{"loopsps", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "//", "Simplify"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "loopsps", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"loopsps", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "->", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"props", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "]"}], 
              RowBox[{"prop", "[", 
               RowBox[{"indices", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"Length", "[", "props", "]"}]}], "}"}]}], "]"}], "/.", 
           
           RowBox[{
            RowBox[{"subrules", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "-", 
         RowBox[{
          RowBox[{"rests", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "loopsps", "]"}]}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9707412497254467`*^9, 3.970741250204856*^9}, {
