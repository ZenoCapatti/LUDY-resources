Cell["This function does partial fractioning", "Text",
 CellChangeTimes->{{3.970741337653163*^9, 
  3.9707413469510727`*^9}},ExpressionUUID->"6cfcd2f4-76bd-43a9-82a6-\
3a2414ba074a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"partialFractioner", "[", "props_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"loopsps", ",", "mons", ",", "solpf"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"loopsps", "=", 
      RowBox[{"loopProducts", "[", "props", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mons", "=", 
      RowBox[{"MonomialList", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", "prop", "]"}], "prop"}], ",", 
          RowBox[{"{", 
           RowBox[{"prop", ",", "props"}], "}"}]}], "]"}], ",", "loopsps"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solpf", "=", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"mons", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "==", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"j", "==", "4"}], ",", "1", ",", "0"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"a", "[", "prop", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"prop", ",", "props"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"props", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "]"}], 
         RowBox[{"prop", "[", "j", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "[", "props", "]"}]}], "}"}]}], "]"}], "/.", 
      RowBox[{"solpf", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"partialFractioner", "[", "prp", "]"}]}], "Input",
 CellChangeTimes->{{3.97074132859619*^9, 3.970741335578581*^9}, {
   3.970741590524859*^9, 3.970741600053658*^9}, {3.970745022326148*^9, 
   3.9707450258442574`*^9}, 3.970745165395759*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"57131f23-91dc-40c1-bf66-0935841e7488"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{"prop", "[", "1", "]"}], 
    RowBox[{
     SuperscriptBox["m", "2"], "-", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
       RowBox[{"p", "[", "2", "]"}]}]}]}]]}], "-", 
  FractionBox[
   RowBox[{"prop", "[", "2", "]"}], 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["m", "2"]}], "+", 
