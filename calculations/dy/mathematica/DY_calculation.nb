Cell[BoxData[
 RowBox[{"prp", "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sq", "[", 
       RowBox[{"q", "[", "1", "]"}], "]"}], "-", 
      RowBox[{"m", "^", "2"}]}], ",", 
     RowBox[{"Sq", "[", 
      RowBox[{
       RowBox[{"q", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "1", "]"}]}], "]"}], ",", 
     RowBox[{"Sq", "[", 
      RowBox[{
       RowBox[{"q", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "2", "]"}]}], "]"}], ",", 
     RowBox[{"Sq", "[", 
      RowBox[{
       RowBox[{"q", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "1", "]"}], "-", 
       RowBox[{"p", "[", "2", "]"}]}], "]"}]}], "}"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sq", "[", "x_", "]"}], ":>", 
     RowBox[{"IP", "[", 
      RowBox[{"x", ",", "x"}], "]"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.971251387417583*^9, 3.9712513878263474`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"7326e078-a123-4fc1-98f4-f227cc3525a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["m", "2"]}], "+", 
    RowBox[{
     RowBox[{"q", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"q", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "1", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
      RowBox[{"q", "[", "1", "]"}]}]}], "+", 
    RowBox[{
     RowBox[{"q", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"q", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "2", "]"}], "\[CenterDot]", 
