Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["m", "2"]}], "+", 
    RowBox[{
     RowBox[{"q", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"q", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "[", "1", "]"}], "\[CenterDot]", 
     RowBox[{"p", "[", "1", "]"}]}], "-", 
